generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Core Business Models ────────────────────────────────────────────────────

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  gstNo     String?  @db.VarChar(50)
  email     String?  @db.VarChar(100)
  date      DateTime @db.Date
  status    String   @default("active") @db.VarChar(20)
  ssiNo     String?  @db.VarChar(50)
  panNo     String?  @db.VarChar(20)
  phone     String?  @db.VarChar(20)
  esiNo     String?  @db.VarChar(50)
  address   String?  @db.Text
  epfNo     String?  @db.VarChar(50)
  state     String?  @db.VarChar(50)
  stateCode String?  @db.VarChar(5) @map("state_code")

  bankHolderName    String? @db.VarChar(100) @map("bank_holder_name")
  bankAccountNumber String? @db.VarChar(30) @map("bank_account_number")
  bankIfscCode      String? @db.VarChar(20) @map("bank_ifsc_code")
  bankName          String? @db.VarChar(100) @map("bank_name")
  bankBranchName    String? @db.VarChar(100) @map("bank_branch_name")

  website   String?  @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoices Invoice[]

  @@map("companies")
}

model ToCompany {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  gstNo      String?  @db.VarChar(50)
  vendorCode String?  @db.VarChar(50) @map("vendor_code")
  email      String?  @db.VarChar(100)
  address    String?  @db.Text
  state      String?  @db.VarChar(50)
  stateCode  String?  @db.VarChar(5) @map("state_code")
  date       DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  invoices        Invoice[]
  billedInvoices  Invoice[] @relation("BillTo")
  shippedInvoices Invoice[] @relation("ShipTo")

  @@map("to_companies")
}

model Referral {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String?  @db.VarChar(100)
  mobile    String?  @db.VarChar(20)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referrals")
}

model Invoice {
  id          Int      @id @default(autoincrement())
  orderId     String   @db.VarChar(50) @map("order_id")
  companyId   Int?     @map("company_id")
  toCompanyId Int?     @map("to_company_id")
  billToCompanyId Int? @map("bill_to_company_id")
  shipToCompanyId Int? @map("ship_to_company_id")
  email       String?  @db.VarChar(100)
  gst         String?  @db.VarChar(50)
  amount      Decimal? @db.Decimal(12, 2)
  total       Decimal? @db.Decimal(12, 2)
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  taxType  String  @default("CGST_SGST") @db.VarChar(20) @map("tax_type")
  cgstRate Decimal @default(0) @db.Decimal(5, 2) @map("cgst_rate")
  sgstRate Decimal @default(0) @db.Decimal(5, 2) @map("sgst_rate")
  igstRate Decimal @default(0) @db.Decimal(5, 2) @map("igst_rate")

  reverseCharge  Boolean @default(false) @map("reverse_charge")
  invoiceNo      String? @db.VarChar(20) @map("invoice_no")
  challanNo      String? @db.VarChar(50) @map("challan_no")
  transportMode  String? @db.VarChar(50) @map("transport_mode")
  vehicleNo      String? @db.VarChar(50) @map("vehicle_no")
  dateOfSupply   DateTime? @db.Date @map("date_of_supply")
  placeOfSupply  String? @db.VarChar(100) @map("place_of_supply")
  stateCode      String? @db.VarChar(5) @map("state_code")

  bankHolderName    String? @db.VarChar(100) @map("bank_holder_name")
  bankAccountNumber String? @db.VarChar(50) @map("bank_account_number")
  bankIfscCode      String? @db.VarChar(20) @map("bank_ifsc_code")
  bankName          String? @db.VarChar(100) @map("bank_name")
  bankBranchName    String? @db.VarChar(100) @map("bank_branch_name")

  billToName      String? @db.VarChar(200) @map("bill_to_name")
  billToAddress   String? @db.VarChar(500) @map("bill_to_address")
  billToGstin     String? @db.VarChar(50) @map("bill_to_gstin")
  billToEmail     String? @db.VarChar(100) @map("bill_to_email")
  billToState     String? @db.VarChar(50) @map("bill_to_state")
  billToStateCode String? @db.VarChar(5) @map("bill_to_state_code")

  shipToName      String? @db.VarChar(200) @map("ship_to_name")
  shipToAddress   String? @db.VarChar(500) @map("ship_to_address")
  shipToGstin     String? @db.VarChar(50) @map("ship_to_gstin")
  shipToEmail     String? @db.VarChar(100) @map("ship_to_email")
  shipToState     String? @db.VarChar(50) @map("ship_to_state")
  shipToStateCode String? @db.VarChar(5) @map("ship_to_state_code")

  termsAndConditions String? @db.Text @map("terms_and_conditions")
  logoUrl           String? @db.LongText @map("logo_url")
  phone             String? @db.VarChar(100) @map("phone")

  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  toCompany     ToCompany? @relation(fields: [toCompanyId], references: [id], onDelete: SetNull)
  billToCompany ToCompany? @relation("BillTo", fields: [billToCompanyId], references: [id], onDelete: SetNull)
  shipToCompany ToCompany? @relation("ShipTo", fields: [shipToCompanyId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          Int      @id @default(autoincrement())
  invoiceId   Int      @map("invoice_id")
  description String?  @db.VarChar(255)
  hsn         String?  @db.VarChar(20)
  sac         String?  @db.VarChar(20)
  quantity    Decimal  @default(0) @db.Decimal(10, 2)
  unit        String   @default("Pcs") @db.VarChar(10)
  price       Decimal  @default(0) @db.Decimal(12, 2)
  per         String   @default("Pcs") @db.VarChar(10)
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  gstType     String?  @db.VarChar(20) @map("gst_type")
  igstRate    Decimal? @db.Decimal(5, 2) @map("igst_rate")
  cgstRate    Decimal? @db.Decimal(5, 2) @map("cgst_rate")
  sgstRate    Decimal? @db.Decimal(5, 2) @map("sgst_rate")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Purchase {
  id            Int      @id @default(autoincrement())
  gstNo         String?  @db.VarChar(50) @map("gst_no")
  partyName     String   @db.VarChar(100) @map("party_name")
  invoiceNo     String   @db.VarChar(50) @map("invoice_no")
  invoiceDate   DateTime @db.Date @map("invoice_date")
  state         String?  @db.VarChar(50)
  rate          Decimal  @default(0) @db.Decimal(5, 2)
  taxableValue  Decimal  @default(0) @db.Decimal(12, 2) @map("taxable_value")
  igst          Decimal  @default(0) @db.Decimal(12, 2)
  cgst          Decimal  @default(0) @db.Decimal(12, 2)
  sgst          Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(12, 2) @map("total_amount")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("purchases")
}

model User {
  id         Int      @id @default(autoincrement())
  firstName  String   @db.VarChar(50) @map("first_name")
  lastName   String   @db.VarChar(50) @map("last_name")
  username   String   @db.VarChar(50) @unique
  password   String   @db.VarChar(255)
  email      String?  @db.VarChar(100)
  phone      String?  @db.VarChar(20)
  role       String   @default("user") @db.VarChar(20)
  status     String   @default("active") @db.VarChar(20)
  sidebarAccess String? @db.Text @map("sidebar_access")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Import / Export / Backup History ────────────────────────────────────────

model ImportHistory {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  fileName  String   @db.VarChar(255) @map("file_name")
  fileType  String   @db.VarChar(20) @map("file_type")
  fileSize  String   @db.VarChar(20) @map("file_size")
  status    String   @db.VarChar(20) // success, failed, pending, processing
  user      String   @db.VarChar(50)
  imported  Int      @default(0)
  skipped   Int      @default(0)
  failed    Int      @default(0)
  errorMsg  String?  @db.Text @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("import_history")
}

model ExportHistory {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  fileName  String   @db.VarChar(255) @map("file_name")
  fileType  String   @db.VarChar(20) @map("file_type")
  fileSize  String   @db.VarChar(20) @map("file_size")
  format    String   @db.VarChar(20)
  status    String   @db.VarChar(20) // success, failed, pending
  user      String   @db.VarChar(50)
  recordCount Int    @default(0) @map("record_count")
  errorMsg  String?  @db.Text @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("export_history")
}

model BackupHistory {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  fileName  String   @db.VarChar(255) @map("file_name")
  fileType  String   @db.VarChar(20) @map("file_type")
  fileSize  String   @db.VarChar(20) @map("file_size")
  format    String   @db.VarChar(20)
  status    String   @db.VarChar(20) // success, failed, pending
  user      String   @db.VarChar(50)
  recordCount Int    @default(0) @map("record_count")
  errorMsg  String?  @db.Text @map("error_message")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("backup_history")
}
